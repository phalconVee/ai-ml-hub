# Copy to .env and fill in. Never commit the real .env.

# Required: your Claude API key (https://platform.claude.com/settings/keys).
# Used for answers, follow-up rewriting, memory summaries and the podcast script.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: ElevenLabs for nicer audio-overview voices. Leave empty to use the
# free local voices (macOS `say`, or `espeak-ng` on Linux).
# ELEVENLABS_API_KEY=
# SOURCEBOOK_ELEVEN_VOICE_A=21m00Tcm4TlvDq8ikWAM
# SOURCEBOOK_ELEVEN_VOICE_B=pNInz6obpgDQGcFmaJgB

# Optional overrides (defaults shown).
# SOURCEBOOK_MODEL=claude-opus-5-5
# SOURCEBOOK_EFFORT=medium
# SOURCEBOOK_HOME=.sourcebook
# SOURCEBOOK_TTS=auto            # auto | say | espeak | elevenlabs | none
