# Copy to .env and fill in. Only the first line is required.

# --- Required -----------------------------------------------------------------
# Claude API key (https://platform.claude.com). Not needed if you've run `ant auth login`.
ANTHROPIC_API_KEY=

# --- Not needed ---------------------------------------------------------------
# The search side needs NO keys: DuckDuckGo, Hacker News (Algolia) and Wikipedia
# are all free and keyless.

# --- Optional overrides (defaults shown) --------------------------------------
# OMNI_SCOUT_PLANNER_MODEL=claude-opus-5-5
# OMNI_SCOUT_SCOUT_MODEL=claude-opus-5-5
# OMNI_SCOUT_SYNTH_MODEL=claude-opus-5-5
# OMNI_SCOUT_PLANNER_EFFORT=medium      # low | medium | high | xhigh | max
# OMNI_SCOUT_SCOUT_EFFORT=low
# OMNI_SCOUT_SYNTH_EFFORT=high
# OMNI_SCOUT_MAX_TURNS=6                # tool-calling rounds per scout
# OMNI_SCOUT_MAX_PLATFORMS=4            # scouts per question
# OMNI_SCOUT_MAX_TOOL_CHARS=6000        # tool output clipped to this before reaching Claude
