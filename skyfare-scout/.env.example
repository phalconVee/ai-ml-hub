# Copy this file to .env and fill it in. Never commit .env.

# Required. Every agent (trip parser, fare scout, advisor) is a Claude call.
# The keyless flight search also runs through Claude: it uses Claude's
# server-side web search tool, so there is no separate search-API key.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Real Google Flights results via SerpApi (it has a free plan:
# sign up at https://serpapi.com). Leave empty and the app falls back to
# Claude web search, which gives indicative fares with source links.
SERPAPI_API_KEY=
