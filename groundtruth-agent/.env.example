# Copy to .env and fill in. Never commit the real .env.

# Required: your Claude API key (https://platform.claude.com/settings/keys).
# Used by the agent (answers) and, if enabled, the figure describer (vision).
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown).
# GROUNDTRUTH_MODEL=claude-opus-5-5
# GROUNDTRUTH_FIGURE_MODEL=claude-opus-5-5
# GROUNDTRUTH_EFFORT=medium
