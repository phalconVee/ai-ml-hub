# Required: the only key the default setup needs. Claude writes the replies and
# extracts the facts that grow the knowledge graph. (If you've run
# `ant auth login`, the SDK finds that profile and this line is optional.)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: a paid cloud voice. Leave empty to use the free voices (Kokoro if
# installed, macOS `say`, or your browser's own speech). Only used when you
# pick "ElevenLabs" in the sidebar.
ELEVENLABS_API_KEY=
