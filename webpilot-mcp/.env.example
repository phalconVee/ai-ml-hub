# Copy to .env and fill in. Only the first line is required.

# --- Required -----------------------------------------------------------------
# Claude API key (https://platform.claude.com). Not needed if you've run `ant auth login`.
ANTHROPIC_API_KEY=

# --- Not needed ---------------------------------------------------------------
# The browser side needs NO keys: it is a local Chromium driven by Playwright.
# (Install it once with: uv run playwright install chromium)

# --- Optional overrides (defaults shown; most are also in the UI sidebar) ------
# WEBPILOT_MODEL=claude-opus-5-5
# WEBPILOT_EFFORT=low                  # low | medium | high | xhigh | max
# WEBPILOT_MAX_STEPS=15                # Claude turns per goal
# WEBPILOT_READ_ONLY=1                 # 0 = allow typing + (approved) form submission
# WEBPILOT_ALLOW=                      # e.g. news.ycombinator.com,wikipedia.org (empty = any)
# WEBPILOT_DENY=                       # e.g. facebook.com,mybank.com (always blocked)
# WEBPILOT_HEADLESS=1                  # 0 = show the Chromium window
# WEBPILOT_MAX_PAGE_CHARS=8000         # page text clipped to this before reaching Claude
