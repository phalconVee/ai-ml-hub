# Copy to .env and fill in. Never commit .env.

# Claude brain (default). The only paid key. Not needed for the 100%-local Ollama mode.
ANTHROPIC_API_KEY=

# Ollama brain (optional, local, free). Defaults shown; change if you pulled another model.
OLLAMA_MODEL=qwen3:4b
OLLAMA_HOST=http://localhost:11434

# Hotel data needs no keys: Claude web search (uses ANTHROPIC_API_KEY),
# OpenStreetMap (Nominatim + Overpass, free) or the offline demo data.
