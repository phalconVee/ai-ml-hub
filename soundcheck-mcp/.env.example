# Copy to .env and fill in. Nothing here is required to transcribe or analyse
# audio: Whisper runs locally and sentiment/search/speakers are local too.

# --- Needed for the chat agent (and Claude-quality summaries/topics) --------
# Claude API key (https://platform.claude.com). Not needed if you've run `ant auth login`
# (then also set SOUNDCHECK_ANALYSIS=claude so the server uses Claude for summaries).
ANTHROPIC_API_KEY=

# --- Optional, paid: real neural speaker diarization --------------------------
# Only used when you ask for engine="assemblyai" (per call or via SOUNDCHECK_ENGINE).
# A key here never switches engines on its own.
ASSEMBLYAI_API_KEY=

# --- Optional overrides (defaults shown) ----------------------------------------
# SOUNDCHECK_ENGINE=auto                # auto (= local) | local | assemblyai
# SOUNDCHECK_WHISPER_MODEL=base         # tiny | base | small | medium | large-v3 | turbo
# SOUNDCHECK_WHISPER_DEVICE=auto        # auto | cpu | cuda
# SOUNDCHECK_WHISPER_COMPUTE=int8       # int8 | float16 | float32
# SOUNDCHECK_ANALYSIS=auto              # auto | claude | local  (summary/topics on the server)
# SOUNDCHECK_AGENT_MODEL=claude-opus-5-5
# SOUNDCHECK_ANALYSIS_MODEL=claude-opus-5-5
# SOUNDCHECK_AGENT_EFFORT=medium        # low | medium | high | xhigh | max
# SOUNDCHECK_ANALYSIS_EFFORT=low
# SOUNDCHECK_MAX_TURNS=8                # tool-calling rounds per chat message
# SOUNDCHECK_MAX_TOOL_CHARS=20000       # tool output clipped to this before reaching Claude
# SOUNDCHECK_DATA_DIR=./data            # transcripts + uploads
# SOUNDCHECK_MAX_UPLOAD_MB=200
