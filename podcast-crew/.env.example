# Required: the only key the default setup needs. Claude writes the outline,
# the script and the edit. (If you've run `ant auth login`, the SDK finds that
# profile and this line is optional.)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: a paid, cloud TTS. Leave empty to use the free local voices
# (Kokoro if installed, else macOS `say`). Only used when you pick
# "ElevenLabs" as the voice engine in the sidebar.
ELEVENLABS_API_KEY=
