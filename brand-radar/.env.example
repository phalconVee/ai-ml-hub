# Copy to .env and fill in. Only the first key is required.

# --- Required -------------------------------------------------------------------
# Claude API key (https://platform.claude.com). Not needed if you've run `ant auth login`.
ANTHROPIC_API_KEY=

# --- Not needed ------------------------------------------------------------------
# Every mention source is free and keyless: DuckDuckGo (news, web, Reddit, YouTube),
# Hacker News (Algolia), Bluesky public search, Mastodon hashtag timelines.
# The optional "Claude web-search sweep" runs on the Anthropic key above.

# --- Optional overrides (defaults shown) -------------------------------------------
# BRAND_RADAR_ANALYST_MODEL=claude-sonnet-5-5
# BRAND_RADAR_ANALYST_EFFORT=low          # low | medium | high | xhigh | max
# BRAND_RADAR_STRATEGIST_MODEL=claude-opus-5-5
# BRAND_RADAR_STRATEGIST_EFFORT=high
# BRAND_RADAR_SWEEP_MODEL=claude-sonnet-5-5
# BRAND_RADAR_PER_SOURCE=15               # raw results asked from each source
# BRAND_RADAR_BATCH_SIZE=15               # mentions per analyst call
# BRAND_RADAR_MAX_PARALLEL=4              # Claude calls in flight at once
# BRAND_RADAR_SWEEP_SEARCHES=5            # web searches the sweep may run
