# Copy to .env and fill in. Never commit .env.

# Required: Claude API key (https://platform.claude.com). Alternatively run
# `ant auth login` once and leave this unset; the SDK picks up that profile.
ANTHROPIC_API_KEY=

# Search backend for the MCP tools server: duckduckgo (free, no key) | tavily | fake (offline)
DEEPDIVE_SEARCH_BACKEND=duckduckgo

# Only needed when DEEPDIVE_SEARCH_BACKEND=tavily (https://tavily.com)
TAVILY_API_KEY=

# Optional overrides
# DEEPDIVE_MODEL=claude-opus-5-5
# DEEPDIVE_PAGE_CHAR_LIMIT=12000
# DEEPDIVE_SEARCH_RESULTS=6
