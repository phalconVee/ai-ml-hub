# Copy to .env and fill in. Only the first key is required.

# Required: the Claude API key used by the chat agent.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: a URL or e-mail put in the web server's User-Agent (Wikipedia asks API users for one).
# WEB_READER_CONTACT=you@example.com

# Optional overrides (defaults shown).
# SWITCHBOARD_MODEL=claude-opus-5-5
# SWITCHBOARD_EFFORT=medium
# SWITCHBOARD_CONFIG=servers.json

# Your own servers can reference more variables in servers.json as ${NAME},
# e.g. "headers": {"Authorization": "Bearer ${MY_SERVER_TOKEN}"}. Put them here.
