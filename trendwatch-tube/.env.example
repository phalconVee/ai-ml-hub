# Copy to .env and fill in. Never commit the real .env.

# Required: Claude. Get a key at https://platform.claude.com/ (or run `ant auth login` instead).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: YouTube Data API v3 key (free, from Google Cloud Console -> APIs & Services).
# Without it the app uses public RSS feeds: no likes/comments, and @handles are resolved best-effort.
YOUTUBE_API_KEY=

# Optional: model overrides. Defaults are shown.
# Set the worker to claude-haiku-5-5 to make per-video analysis much cheaper.
TRENDWATCH_LEAD_MODEL=claude-opus-5-5
TRENDWATCH_WORKER_MODEL=claude-opus-5-5
