# Copy to .env and edit. Every value is optional: with no .env at all the app
# runs fully locally on Ollama with no keys. Never commit .env.

# Which brain drives the agents: "ollama" (local, free) or "claude".
SWARM_BACKEND=ollama

# ── Ollama (default) ─────────────────────────────────────────────
# Any tool-calling model you've pulled (ollama pull qwen3:4b).
OLLAMA_MODEL=qwen3:4b
OLLAMA_HOST=http://localhost:11434
# Let qwen3-style models think before answering (slower, sometimes better).
OLLAMA_THINK=false

# ── Claude (optional) ────────────────────────────────────────────
# Only needed if SWARM_BACKEND=claude or you pick Claude in the sidebar.
ANTHROPIC_API_KEY=
SWARM_CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
SWARM_CLAUDE_EFFORT=low
SWARM_CLAUDE_MAX_TOKENS=8000

# ── Loop and tools ───────────────────────────────────────────────
# Max model calls per user message (stops agents bouncing forever).
SWARM_MAX_STEPS=12
# Web results per search (keyless DuckDuckGo via the ddgs package).
SEARCH_RESULTS=5
