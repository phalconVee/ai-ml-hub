# Copy to .env and fill in. Never commit the real .env.

# Required: your Claude API key (https://platform.claude.com/settings/keys).
# The only paid service this project uses.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown). Nothing below needs an account.
# VAULT_MODEL=claude-opus-5-5
# VAULT_EFFORT=medium
# VAULT_DB=.vault/vault.db          # the single SQLite file that holds all memory
# VAULT_EMBEDDER=fastembed          # fastembed (local ONNX, ~70 MB once) | hash (no download, keyword-ish)
# VAULT_EMBED_MODEL=BAAI/bge-small-en-v1.5
# FASTEMBED_CACHE_PATH=             # where fastembed keeps the downloaded model
