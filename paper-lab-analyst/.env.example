# The only key this app needs. OCR and figure reading use Claude's own vision,
# so there's no OCR service or Tesseract install, and no second API key.
# Copy this file to .env and fill it in. Never commit .env.
# (If you've run `ant auth login`, the SDK finds that profile and .env is optional.)
ANTHROPIC_API_KEY=sk-ant-your-key-here
